# =============================================================
# Жива Аптека — приклад файлу конфігурації
# Скопіюйте цей файл у .env та заповніть своїми значеннями
# =============================================================

# --- Telegram ---
# Отримайте токен від @BotFather у Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# --- ChromaDB ---
# Шлях до директорії, де зберігається векторна база даних
CHROMA_DB_PATH=data/chroma_db

# Назва колекції в ChromaDB
COLLECTION_NAME=herbal_medicine_ua

# --- Шляхи до даних ---
# Директорія, куди потрібно помістити книги (.txt, .pdf)
BOOKS_PATH=data/books

# Директорія для проміжних оброблених файлів
PROCESSED_PATH=data/processed

# --- Модель ембедингів (sentence-transformers) ---
# Рекомендована багатомовна модель з підтримкою української мови
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- Параметри чанкування тексту ---
# Розмір одного чанку в символах
CHUNK_SIZE=512

# Перекриття між сусідніми чанками в символах
CHUNK_OVERLAP=64

# --- RAG параметри ---
# Кількість найближчих результатів із векторної бази
TOP_K_RESULTS=5

# Мінімальний поріг схожості (від 0.0 до 1.0)
SIMILARITY_THRESHOLD=0.3
